# **秘密は絶対に版管理に入れない。** 例だけを .env.example として置く。
.env
.env.*
!.env.example
*/.env

# Node / TypeScript
node_modules/
dist/
build/
*.tsbuildinfo

# Python
.pytest_cache/
*.egg-info/

# 実行時にできるもの（運用データはリポジトリに置かない）
logs/
*.db
*.sqlite3

# --------------------------------------------------------------------------
# game-template（Godot）が足しているもの（TDR-0003）
# --------------------------------------------------------------------------
# Godotのエディタが作る置き場（読み込んだ素材の写し、キャッシュ、export_credentials.cfg）。
# export_presets.cfgはCIでの書き出しに要るので、外さずにGitに入れる。
# Godot 4.1以降は、パスワードなどをexport_presets.cfgではなく.godot/export_credentials.cfgに書く。
# .importと.uidも、ほかの人が開いたときに同じ設定とidで読み込めるよう、Gitに入れる。
.godot/
# Androidのビルドの雛形（エディタの「Androidビルドテンプレートのインストール」で作る）
/android/
# CSVの翻訳から、読み込みのときに作られる
*.translation

# --------------------------------------------------------------------------
# game-template（CCGS）が足しているもの（PDR-0011）
# --------------------------------------------------------------------------
# CCGSの1.2.0の.gitignoreを、エンジンの3つの節（Godot・Unity・Unreal）を除いてそのまま写した。
# Godotの節はTDR-0003で決めたので、上の節に書いた。

# === IDE and Editor ===
.vs/
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# === Claude Code Local ===
.claude/settings.local.json
CLAUDE.local.md
project.local.yaml
production/session-logs/
# Ephemeral per-session checkpoint. directory-structure.md documents this as
# gitignored; the rule was missing, so active.md would have been committed.
production/session-state/
.scratch/
# Per-agent working memory written at runtime — not release material
.claude/agent-memory/
# Worktrees from the prototyper, isolated subagents and `claude --worktree`.
# Each is a separate checkout; staging everything would add it as an embedded
# repository.
.claude/worktrees/


# === Local sandboxes and scratch work ===
examples/
sandbox/
sandboxes/
tests/sandboxes/
qa-sandbox/

# === Runtime Artifacts (auto-generated, start empty on fresh clone) ===
